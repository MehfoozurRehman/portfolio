---
import '../styles/global.css';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, SITE_NAME, SITE_URL, personJsonLd } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION, path = '/', ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE_URL).toString();
const ogImage = `${SITE_URL}/og.png`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, url: SITE_URL, name: SITE_NAME, inLanguage: 'en', publisher: { '@id': `${SITE_URL}/#person` } },
    ...jsonLd,
  ],
};
---

<!doctype html>
<html lang="en" class="h-full bg-[var(--color-page)] antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#efece2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08090b" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mehfooz-ur-Rehman — Full-stack Product Developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var e = localStorage.getItem('portfolio-theme');
          var t = e === 'dark' || e === 'light' ? e : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          d.dataset.theme = t;
          d.style.colorScheme = t;
          d.style.backgroundColor = t === 'dark' ? '#08090b' : '#efece2';
        } catch (_) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="flex min-h-full flex-col bg-[var(--color-page)] font-[family-name:var(--font-nunito)] text-[var(--color-text)]">
    <div class="cursor-highlight pointer-events-none fixed left-0 top-0 z-0 size-[34rem] rounded-full" aria-hidden="true" data-cursor-glow></div>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <slot />

    <button
      type="button"
      aria-label="Scroll back to top"
      data-scroll-top
      class="pointer-events-none fixed bottom-5 right-5 z-50 grid size-12 translate-y-3 place-items-center rounded-full border border-[var(--border-card)] bg-[var(--color-inverse)] text-[var(--color-inverse-text)] opacity-0 shadow-xl shadow-[color:var(--shadow-strong)] transition duration-200 data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 sm:bottom-6 sm:right-6"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
    </button>

    <noscript>
      <img alt="" referrerpolicy="no-referrer-when-downgrade" src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" width="1" height="1" />
    </noscript>
    <script is:inline async defer data-collect-dnt="true" src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <script>
      import '../scripts/behaviors';
    </script>
  </body>
</html>
