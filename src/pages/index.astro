---
import { Image, Picture } from 'astro:assets';
import { ArrowDown, ArrowRight, ArrowUpRight, CodeXml, GraduationCap, Mail, MapPin, MessageCircle, Phone } from '@lucide/astro';
import { education, experience, process, profile, profileHighlights, projects, services, stackGroups, testimonials } from '../data';
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import SectionMarker from '../components/SectionMarker.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import ContactForm from '../islands/contact-form';
import pic from '../assets/pic.webp';
import { getContributions } from '../lib/github';

const shell = 'mx-auto w-full max-w-[1320px] px-5 sm:px-8 lg:px-10';
const display = 'font-[family-name:var(--font-nunito)] font-extrabold leading-[0.98] tracking-[-0.01em]';
const delay = (ms: number) => (ms ? `transition-delay:${ms}ms;animation-delay:${ms}ms` : undefined);

const proof = ['schooliee', 'dsme-globals', 'expo-mobile-apps'].map((slug) => projects.find((p) => p.slug === slug)!);
// Mini heatmap for the "more on GitHub" card: the most recent 22 weeks of real activity.
const gh = await getContributions('MehfoozurRehman');
const MINI_WEEKS = 16;
const miniWeeks: ({ level: number; count: number; date: string } | null)[][] = [];
if (gh) {
  const first = new Date(gh.days[0].date + 'T00:00:00Z');
  let col: ({ level: number; count: number; date: string } | null)[] = Array(first.getUTCDay()).fill(null);
  for (const d of gh.days) {
    col.push(d);
    if (col.length === 7) {
      miniWeeks.push(col);
      col = [];
    }
  }
  if (col.length) miniWeeks.push(col);
}
const recentWeeks = miniWeeks.slice(-MINI_WEEKS);
const recentTotal = recentWeeks.flat().reduce((sum, d) => sum + (d?.count ?? 0), 0);

const contactRows = [
  { icon: Mail, label: profile.email, href: `mailto:${profile.email}` },
  { icon: MessageCircle, label: `WhatsApp · ${profile.phone}`, href: profile.whatsapp },
  { icon: Phone, label: profile.phone, href: `tel:${profile.phone.replaceAll(' ', '')}` },
];
const socials = [
  ['LinkedIn', profile.linkedin],
  ['Instagram', profile.instagram],
  ['GitHub', profile.github],
  ['CodeSandbox', profile.codesandbox],
];
---

<Base>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[var(--color-accent)] focus:px-4 focus:py-2 focus:text-[0.8rem] focus:font-bold focus:text-[var(--color-on-accent)]">Skip to content</a>
  <main id="main" class="relative min-h-screen overflow-x-hidden bg-[var(--color-page)] text-[var(--color-text)]">
    <div id="page-top" aria-hidden="true" class="absolute top-0"></div>
    <SiteNav />

    <section id="top" class="relative flex min-h-svh flex-col overflow-hidden pt-28 sm:pt-32">
      <div class="halo -left-[10%] -top-[10%] h-[40rem] w-[40rem]" style="background: var(--halo-a)"></div>
      <div class="halo -right-[8%] top-[20%] h-[32rem] w-[32rem]" style="background: var(--halo-b)"></div>
      <div
        class="pointer-events-none absolute inset-0 z-0 opacity-70"
        style="background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(120% 80% at 50% 0%, #000 30%, transparent 78%); -webkit-mask-image: radial-gradient(120% 80% at 50% 0%, #000 30%, transparent 78%)"
      >
      </div>

      <div class={`${shell} relative z-10 flex flex-1 flex-col justify-center`}>
        <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
          <div>
            <div class="hero-in">
              <span class="inline-flex items-center gap-2 rounded-full border border-[var(--border-card)] bg-[var(--color-field)] px-3 py-1.5 font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-text)]">
                <span class="relative flex size-2">
                  <span class="absolute inline-flex size-full animate-ping rounded-full bg-[var(--color-accent-2)] opacity-70"></span>
                  <span class="relative inline-flex size-2 rounded-full bg-[var(--color-accent-2)]"></span>
                </span>
                Available for product builds
              </span>
            </div>

            <div class="hero-in" style={delay(60)}>
              <h1 class={`${display} mt-6 text-[clamp(2.1rem,5.6vw,4.3rem)]`}>
                Products built
                <br />
                from{' '}
                <span class="relative whitespace-nowrap text-[var(--color-accent)]">
                  idea
                  <svg class="absolute -bottom-0.5 left-0 w-full" viewBox="0 0 200 12" fill="none" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M2 8c40-6 158-6 196 0" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round"></path>
                  </svg>
                </span>{' '}
                to launch.
              </h1>
            </div>

            <div class="hero-in" style={delay(120)}>
              <p class="mt-7 max-w-[36rem] text-[1rem] leading-8 text-[var(--color-muted)] sm:text-[1.06rem]">
                I'm <span class="font-bold text-[var(--color-text)]">Mehfooz-ur-Rehman</span> — a full-stack product developer shipping web, mobile, desktop, AI and automation systems that businesses
                rely on every day.
              </p>
            </div>

            <div class="hero-in" style={delay(180)}>
              <div class="mt-9 flex flex-wrap items-center gap-2.5 sm:gap-3">
                <a
                  href="#contact"
                  class="group inline-flex min-h-12 items-center gap-2 rounded-full bg-[var(--color-accent)] px-5 text-[0.88rem] font-bold sm:px-6 sm:text-[0.9rem] text-[var(--color-on-accent)] shadow-lg shadow-[color:var(--shadow-accent)] transition hover:shadow-xl"
                >
                  Let's build
                  <ArrowRight size={17} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                </a>
                <a
                  href="/cv.pdf"
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex min-h-12 items-center gap-2 rounded-full border border-[var(--border-card)] bg-[var(--color-field)] px-4 text-[0.88rem] font-bold text-[var(--color-text)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)] sm:px-5 sm:text-[0.9rem]"
                >
                  Download CV
                  <ArrowUpRight size={17} class="hidden min-[400px]:block" aria-hidden="true" />
                </a>
                <a
                  href={profile.github}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="GitHub"
                  class="inline-flex size-12 items-center justify-center gap-2 rounded-full border border-[var(--border-card)] text-[0.9rem] font-bold text-[var(--color-text)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)] sm:w-auto sm:px-5"
                >
                  <CodeXml size={17} aria-hidden="true" /> <span class="hidden sm:inline">GitHub</span>
                </a>
              </div>
            </div>

            <div class="hero-in" style={delay(240)}>
              <div class="mt-11 grid max-w-[34rem] grid-cols-3 gap-4 border-t border-[var(--border-subtle)] pt-6">
                {
                  [
                    ['6+', 'Years shipping'],
                    ['400+', 'Projects built'],
                    [profile.company, 'Currently at'],
                  ].map(([value, label]) => (
                    <div>
                      <div class={`${display} text-[clamp(1.3rem,2.4vw,1.9rem)]`}>{value}</div>
                      <div class="mt-1 font-mono-label text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-soft)]">{label}</div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="hero-in relative mx-auto w-full max-w-[28.5rem]" style={delay(140)}>
            <div class="relative">
              <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br from-[var(--color-accent)]/25 to-[var(--color-accent-2)]/20 blur-2xl"></div>
              <div class="overflow-hidden rounded-[1.7rem] border border-[var(--border-card)] bg-[var(--color-raise)] shadow-[0_30px_80px_-40px_var(--shadow-strong)]">
                <div class="relative aspect-[4/5] w-full overflow-hidden">
                  <Picture
                    src={pic}
                    alt="Portrait of Mehfooz-ur-Rehman"
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={[420, 640, 840]}
                    sizes="(max-width: 1024px) 90vw, 420px"
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                    class="absolute inset-0 size-full object-cover object-center"
                  />
                  <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/55 to-transparent"></div>
                  <div class="absolute inset-x-4 bottom-4 flex items-center justify-between">
                    <div>
                      <div class="font-mono-label text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/70">{profile.role}</div>
                      <div class="mt-0.5 text-[0.95rem] font-extrabold text-white">Web · Mobile · AI</div>
                    </div>
                    <a
                      href="#work"
                      aria-label="View work"
                      class="grid size-11 place-items-center rounded-full bg-white/95 text-[#17140f] transition hover:bg-[var(--color-accent)] hover:text-white"
                    >
                      <ArrowUpRight size={19} aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </div>

              <div class="absolute -left-4 top-8 hidden rounded-2xl border border-[var(--border-card)] bg-[var(--color-page-soft)]/90 px-3.5 py-2.5 shadow-lg shadow-[color:var(--shadow-ambient)] backdrop-blur-md sm:block">
                <div class="font-mono-label text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-[var(--color-soft)]">Stack</div>
                <div class="text-[0.82rem] font-bold text-[var(--color-text)]">Next · Convex · AI</div>
              </div>
              <div class="absolute -right-3 bottom-16 hidden items-center gap-2 rounded-2xl border border-[var(--border-card)] bg-[var(--color-page-soft)]/90 px-3.5 py-2.5 shadow-lg shadow-[color:var(--shadow-ambient)] backdrop-blur-md sm:flex">
                <MapPin size={14} class="text-[var(--color-accent)]" aria-hidden="true" />
                <span class="text-[0.78rem] font-bold text-[var(--color-text)]">Faisalabad, PK</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-12 flex items-center gap-3 font-mono-label text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-soft)]">
          <ArrowDown size={14} class="animate-bounce" aria-hidden="true" />
          Scroll to explore
        </div>
      </div>
    </section>

    <section id="proof" class={`${shell} -mt-2 pb-4 pt-12 sm:pt-16`} aria-labelledby="proof-heading">
      <div class="reveal">
        <SectionMarker index="✦" label="Results" />
        <h2 id="proof-heading" class={`${display} max-w-2xl text-[clamp(1.55rem,2.9vw,2.35rem)]`}>Shipped, in production, and used daily.</h2>
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {
          proof.map((p, i) => (
            <li class="reveal" style={delay(i * 70)}>
              <a
                href={`/case-studies/${p.slug}`}
                data-astro-prefetch="hover"
                class="card-hover group flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)]"
              >
                {p.hero ? (
                  <div class="relative aspect-[16/9] w-full overflow-hidden bg-[var(--color-page-soft)]">
                    <Image src={p.hero} alt="" widths={[400, 640]} sizes="(max-width: 768px) 92vw, 30vw" loading="lazy" class="absolute inset-0 size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]" />
                  </div>
                ) : null}
                <div class="flex flex-1 flex-col justify-between gap-5 p-6">
                  <div>
                    <p class="font-mono-label text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-soft)]">{p.title.split(':')[0]}</p>
                    <p class={`${display} mt-2 text-[1.2rem] leading-snug`}>{p.result}</p>
                  </div>
                  <span class="inline-flex items-center gap-1.5 font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
                    Read the case study <ArrowRight size={13} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="about" class={`${shell} py-14 sm:py-20`}>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="reveal">
          <SectionMarker index="01" label="Profile" />
          <h2 class={`${display} text-[clamp(1.55rem,2.9vw,2.35rem)]`}>A product developer with real, practical range.</h2>
          <p class="mt-6 text-[0.98rem] leading-8 text-[var(--color-muted)]">{profile.about}</p>
          <p class="mt-4 text-[0.98rem] leading-8 text-[var(--color-muted)]">{profile.subheadline}</p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {
            profileHighlights.map((item, i) => {
              const Icon = item.icon;
              return (
                <article class="reveal card-hover flex flex-col rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-6" style={delay(i * 70)}>
                  <span class="grid size-11 place-items-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
                    <Icon size={22} aria-hidden="true" />
                  </span>
                  <h3 class="mt-5 text-[1.05rem] font-extrabold leading-tight">{item.title}</h3>
                  <p class="mt-2 text-[0.9rem] leading-7 text-[var(--color-muted)]">{item.text}</p>
                </article>
              );
            })
          }
        </div>
      </div>
          <div class="reveal mt-16">
        <p class="font-mono-label text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[var(--color-accent)]">Toolkit</p>
        <h3 class={`${display} mt-4 text-[1.4rem]`}>Modern tools I already use to ship.</h3>
        <div class="mt-8 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
          {
            stackGroups.map((group) => (
              <div class="border-t border-[var(--border-card)] pt-4">
                <h4 class="font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.16em] text-[var(--color-soft)]">{group.label}</h4>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <li class="rounded-full border border-[var(--border-card)] bg-[var(--color-raise)] px-3 py-1.5 font-mono-label text-[0.7rem] font-semibold text-[var(--color-text)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)]">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="services" class="border-y border-[var(--border-subtle)] bg-[var(--color-page-soft)]">
      <div class={`${shell} py-14 sm:py-20`}>
        <div class="reveal">
          <SectionMarker index="02" label="What I build" />
          <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
            <h2 class={`${display} text-[clamp(1.55rem,2.9vw,2.35rem)]`}>Complete business systems, not isolated screens.</h2>
            <p class="text-[0.96rem] leading-8 text-[var(--color-muted)]">
              I build the workflows around the screen too: data, roles, automation, integrations and the launch details that make software actually usable.
            </p>
          </div>
        </div>

        <div class="mt-12 divide-y divide-[var(--border-subtle)] border-t border-[var(--border-subtle)]">
          {
            services.map((service, i) => {
              const Icon = service.icon;
              return (
                <article class="reveal group grid grid-cols-[auto_1fr] items-start gap-5 py-7 transition sm:grid-cols-[auto_0.4fr_1fr] sm:items-center sm:gap-8">
                  <span class="font-mono-label text-[0.72rem] font-semibold text-[var(--color-soft)]">0{i + 1}</span>
                  <div class="flex items-center gap-4">
                    <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-[var(--border-card)] bg-[var(--color-raise)] text-[var(--color-accent)] transition group-hover:border-[var(--border-hover)]">
                      <Icon size={22} aria-hidden="true" />
                    </span>
                    <h3 class="text-[1.2rem] font-extrabold leading-tight transition group-hover:text-[var(--color-accent)]">{service.title}</h3>
                  </div>
                  <p class="col-span-2 text-[0.92rem] leading-7 text-[var(--color-muted)] sm:col-span-1">{service.description}</p>
                </article>
              );
            })
          }
        </div>

        <div class="reveal mt-20">
          <p class="font-mono-label text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[var(--color-accent)]">How I work</p>
          <h3 class={`${display} mt-4 max-w-2xl text-[clamp(1.3rem,2.2vw,1.8rem)]`}>A direct path from workflow to working software.</h3>
          <ol class="mt-8 grid gap-4 md:grid-cols-3">
            {
              process.map((item, i) => {
                const Icon = item.icon;
                return (
                  <li class="card-hover relative overflow-hidden rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-6">
                    <span class={`${display} absolute -right-2 -top-3 text-[5rem] text-[var(--color-text)] opacity-[0.05]`} aria-hidden="true">{i + 1}</span>
                    <span class="grid size-11 place-items-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
                      <Icon size={22} aria-hidden="true" />
                    </span>
                    <h4 class="mt-5 text-[1.1rem] font-extrabold leading-tight">{item.title.replace(/^\d+\.\s*/, '')}</h4>
                    <p class="mt-2 text-[0.9rem] leading-7 text-[var(--color-muted)]">{item.text}</p>
                  </li>
                );
              })
            }
          </ol>
        </div>
      </div>
    </section>

    <section id="work" class={`${shell} py-14 sm:py-20`}>
      <div class="reveal">
        <SectionMarker index="03" label="Featured work" />
        <h2 class={`${display} max-w-2xl text-[clamp(1.55rem,2.9vw,2.35rem)]`}>Products shaped around operations, revenue and daily use.</h2>
      </div>

      <p class="mt-6 font-mono-label text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-[var(--color-soft)] md:hidden" aria-hidden="true">Swipe to browse →</p>
      <div class="carousel mt-6 md:mt-12 md:grid-cols-2 xl:grid-cols-3">
        {
          projects.map((project, i) => {
            const Icon = project.icon;
            const featured = i === 0;
            return (
              <article
                class={`carousel-item card-hover group flex flex-col overflow-hidden rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] ${
                  featured ? 'md:col-span-2 md:grid md:grid-cols-[1.1fr_0.9fr] xl:col-span-3' : ''
                }`}
              >
                {project.hero ? (
                  <div class={`relative aspect-[16/10] w-full overflow-hidden bg-[var(--color-page-soft)] ${featured ? 'md:aspect-auto md:min-h-[24rem]' : ''}`}>
                    <Image
                      src={project.hero}
                      alt={`${project.title} preview`}
                      widths={featured ? [600, 900, 1200] : [400, 640, 800]}
                      sizes={featured ? '(max-width: 768px) 84vw, 55vw' : '(max-width: 768px) 84vw, (max-width: 1280px) 50vw, 33vw'}
                      loading={featured ? 'eager' : 'lazy'}
                      decoding="async"
                      class="absolute inset-0 size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/25 to-transparent opacity-0 transition group-hover:opacity-100" />
                    {featured ? (
                      <span class="absolute left-4 top-4 rounded-full bg-[var(--color-accent)] px-3 py-1 font-mono-label text-[0.6rem] font-bold uppercase tracking-[0.16em] text-[var(--color-on-accent)]">Featured</span>
                    ) : null}
                  </div>
                ) : (
                  <div class="relative flex aspect-[16/10] w-full items-center justify-center overflow-hidden bg-gradient-to-br from-[var(--color-accent)]/12 to-[var(--color-accent-2)]/10">
                    <Icon size={44} class="text-[var(--color-accent)] opacity-80" aria-hidden="true" />
                  </div>
                )}

                <div class={`flex flex-1 flex-col p-5 ${featured ? 'md:justify-center md:p-10' : ''}`}>
                  <div class="mb-3 flex items-center gap-2.5">
                    {project.logo ? (
                      <span class="grid size-8 shrink-0 place-items-center overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-[var(--color-page)]">
                        <Image src={project.logo} alt="" width={40} height={40} class="size-5 object-contain" aria-hidden="true" />
                      </span>
                    ) : null}
                    <span class="font-mono-label text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-soft)]">{project.category}</span>
                  </div>

                  <h3 class={featured ? 'text-[1.25rem] font-extrabold leading-tight md:text-[clamp(1.6rem,2.4vw,2.1rem)] md:leading-[1.08]' : 'text-[1.25rem] font-extrabold leading-tight'}>{project.title}</h3>
                  <p class="mt-2.5 text-[0.88rem] leading-7 text-[var(--color-muted)] md:text-[0.95rem]">{project.summary}</p>
                  {featured ? (
                    <p class="mt-4 hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--color-page)] p-4 text-[0.92rem] font-bold leading-7 md:block">
                      <span class="mb-1 block font-mono-label text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-[var(--color-accent)]">Result</span>
                      {project.result}
                    </p>
                  ) : null}

                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {project.stack.slice(0, featured ? 6 : 4).map((s) => (
                      <span class="rounded-md border border-[var(--border-subtle)] bg-[var(--color-page)] px-2 py-1 font-mono-label text-[0.62rem] font-semibold tracking-[0.04em] text-[var(--color-muted)]">{s}</span>
                    ))}
                  </div>

                  <div class={`mt-auto flex items-center gap-2 pt-6 ${featured ? 'md:mt-6 md:max-w-sm md:pt-0' : ''}`}>
                    <a
                      href={`/case-studies/${project.slug}`}
                      data-astro-prefetch="hover"
                      class="inline-flex flex-1 items-center justify-center gap-2 rounded-full border border-[var(--border-card)] px-4 py-2.5 text-[0.78rem] font-bold text-[var(--color-text)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)]"
                    >
                      Case study
                      <ArrowRight size={14} aria-hidden="true" />
                    </a>
                    {project.url ? (
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`Visit ${project.title}`}
                        class="grid size-10 shrink-0 place-items-center rounded-full bg-[var(--color-inverse)] text-[var(--color-inverse-text)] transition hover:bg-[var(--color-accent)] hover:text-[var(--color-on-accent)]"
                      >
                        <ArrowUpRight size={16} aria-hidden="true" />
                      </a>
                    ) : null}
                  </div>
                </div>
              </article>
            );
          })
        }
        <a
          href={`${profile.github}?tab=repositories`}
          target="_blank"
          rel="noreferrer"
          class="carousel-item card-hover group relative flex min-h-[16rem] flex-col items-start justify-between gap-6 overflow-hidden rounded-2xl border border-dashed border-[var(--border-card)] bg-[var(--color-page-soft)] p-7"
        >
          <div class="w-full">
            <div class="flex items-center justify-between gap-3">
              <span class="grid size-12 place-items-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)]"><CodeXml size={22} aria-hidden="true" /></span>
              {recentTotal > 0 ? (
                <span class="text-right">
                  <span class={`${display} block text-[1.5rem] leading-none`}>{recentTotal.toLocaleString('en-US')}</span>
                  <span class="mt-1 block font-mono-label text-[0.58rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-soft)]">contributions · {recentWeeks.length} weeks</span>
                </span>
              ) : null}
            </div>
            {recentWeeks.length ? (
              <svg viewBox={`0 0 ${recentWeeks.length * 12 - 3} 81`} class="gh-cal mt-6 block h-auto w-full" role="img" aria-label={`Recent GitHub activity: ${recentTotal} contributions in the last ${recentWeeks.length} weeks`}>
                {recentWeeks.map((week, wi) =>
                  week.map((day, di) => (day ? <rect x={wi * 12} y={di * 12} width="9" height="9" rx="2.5" data-level={day.level} /> : null)),
                )}
              </svg>
            ) : null}
          </div>
          <div>
            <p class={`${display} text-[1.35rem] leading-snug`}>There's more on GitHub.</p>
            <p class="mt-2 text-[0.9rem] leading-7 text-[var(--color-muted)]">Open-source experiments, tools and side projects.</p>
            <span class="mt-5 inline-flex items-center gap-1.5 font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
              Browse repositories <ArrowUpRight size={13} aria-hidden="true" />
            </span>
          </div>
        </a>
      </div>
    </section>

    <GitHubActivity />

    <section id="experience" class="border-y border-[var(--border-subtle)] bg-[var(--color-page-soft)]">
      <div class={`${shell} py-14 sm:py-20`}>
        <div class="reveal">
          <SectionMarker index="04" label="Experience" />
          <h2 class={`${display} max-w-2xl text-[clamp(1.55rem,2.9vw,2.35rem)]`}>Work across schools, SaaS teams and business systems.</h2>
        </div>

        <div class="mt-12 border-l border-[var(--border-card)] pl-6 sm:pl-8">
          {
            experience.map((item, i) => (
              <article class="reveal relative pb-10 last:pb-0 lg:grid lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12" style={delay(i * 50)}>
                <span class="absolute -left-[calc(1.5rem+5px)] top-1.5 grid size-2.5 place-items-center rounded-full bg-[var(--color-accent)] ring-4 ring-[var(--color-page-soft)] sm:-left-[calc(2rem+5px)]" />
                <div>
                  <div class="font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">{item.period}</div>
                  <h3 class="mt-2 text-[1.2rem] font-extrabold leading-tight">{item.role}</h3>
                  <p class="mt-1 text-[0.92rem] font-bold text-[var(--color-soft)]">
                    {item.company} · {item.location}
                  </p>
                </div>
                <div class="mt-3 lg:mt-0">
                  <p class="text-[0.92rem] leading-7 text-[var(--color-muted)]">{item.summary}</p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {item.skills.map((skill) => (
                      <span class="rounded-md border border-[var(--border-subtle)] bg-[var(--color-raise)] px-2.5 py-1 font-mono-label text-[0.64rem] font-semibold text-[var(--color-muted)]">{skill}</span>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <div class="reveal mt-14 border-t border-[var(--border-subtle)] pt-10">
          <p class="font-mono-label text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[var(--color-accent)]">Education</p>
          <div class="mt-6 grid gap-4 lg:grid-cols-2">
            {
              education.map((item) => (
                <article class="rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-6">
                  <div class="flex items-start gap-4">
                    <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-[var(--color-inverse)] text-[var(--color-inverse-text)]">
                      <GraduationCap size={22} aria-hidden="true" />
                    </span>
                    <div>
                      <h3 class="text-[1.12rem] font-extrabold leading-tight">{item.school}</h3>
                      <p class="mt-1 text-[0.9rem] text-[var(--color-muted)]">{item.degree}</p>
                      <p class="mt-2 font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">{item.period}</p>
                    </div>
                  </div>
                  <div class="mt-5 flex flex-wrap gap-1.5">
                    {item.focus.map((f) => (
                      <span class="rounded-md border border-[var(--border-subtle)] bg-[var(--color-page)] px-2.5 py-1 font-mono-label text-[0.64rem] font-semibold text-[var(--color-muted)]">{f}</span>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="testimonials" class={`${shell} py-14 sm:py-20`}>
      <div class="reveal">
        <SectionMarker index="05" label="Testimonials" />
        <h2 class={`${display} max-w-2xl text-[clamp(1.55rem,2.9vw,2.35rem)]`}>What clients and teammates already say.</h2>
      </div>
      <div class="carousel mt-10 md:mt-12 lg:grid lg:grid-cols-3">
        {
          testimonials.map((t) => (
            <blockquote class="carousel-item card-hover flex flex-col rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-6">
              <span class={`${display} text-[3rem] leading-none text-[var(--color-accent)]/30`} aria-hidden="true">&ldquo;</span>
              <p class="-mt-3 text-[1.02rem] font-bold leading-8 text-[var(--color-text)]">{t.quote}</p>
              <footer class="mt-6 flex items-center gap-3 border-t border-[var(--border-subtle)] pt-5">
                <span class="grid size-10 place-items-center rounded-full bg-[var(--color-accent)]/12 font-extrabold text-[var(--color-accent)]" aria-hidden="true">{t.name.charAt(0)}</span>
                <span>
                  <span class="block text-[0.9rem] font-extrabold">{t.name}</span>
                  <span class="block text-[0.8rem] text-[var(--color-muted)]">{t.role}</span>
                </span>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </section>

    <section id="contact" class="relative overflow-hidden border-t border-[var(--border-subtle)] bg-[var(--color-page-soft)]">
      <div class="halo -bottom-[20%] left-[10%] h-[30rem] w-[30rem]" style="background: var(--halo-a)"></div>
      <div class={`${shell} relative z-10 grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16`}>
        <div class="reveal">
          <SectionMarker index="06" label="Start here" />
          <h2 class={`${display} text-[clamp(1.7rem,3.1vw,2.55rem)]`}>Need a reliable developer to build your product?</h2>
          <p class="mt-6 max-w-xl text-[0.98rem] leading-8 text-[var(--color-muted)]">
            Send the workflow, product idea or stuck project. I'm strongest when the job needs product thinking, full-stack execution and a practical launch path.
          </p>

          <div class="mt-8 grid gap-2.5">
            {
              contactRows.map((row) => {
                const Icon = row.icon;
                return (
                  <a href={row.href} class="card-hover flex items-center gap-3 rounded-xl border border-[var(--border-card)] bg-[var(--color-raise)] px-4 py-3.5 text-[0.9rem] font-bold text-[var(--color-text)]">
                    <span class="grid size-9 place-items-center rounded-lg bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
                      <Icon size={16} aria-hidden="true" />
                    </span>
                    {row.label}
                    <ArrowUpRight size={15} class="ml-auto text-[var(--color-soft)]" aria-hidden="true" />
                  </a>
                );
              })
            }
          </div>

          <button
            type="button"
            data-copy={profile.email}
            class="mt-3 inline-flex min-h-10 items-center gap-2 rounded-full border border-dashed border-[var(--border-card)] px-4 font-mono-label text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)]"
          >
            <span data-copy-label aria-live="polite">Copy email address</span>
          </button>

          <div class="mt-6 flex flex-wrap gap-2">
            {
              socials.map(([label, href]) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border-card)] px-3.5 py-2 font-mono-label text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-text)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)]"
                >
                  {label}
                  <ArrowUpRight size={13} aria-hidden="true" />
                </a>
              ))
            }
          </div>
        </div>

        <div class="reveal" style={delay(80)}>
          <ContactForm client:visible />
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Base>
