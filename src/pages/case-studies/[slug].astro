---
import { Image } from 'astro:assets';
import { ArrowLeft, ArrowRight, ArrowUpRight, CircleCheck } from '@lucide/astro';
import type { GetStaticPaths } from 'astro';
import { profile, projects } from '../../data';
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import { SITE_URL } from '../../lib/site';

export const getStaticPaths = (() => projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

const { project } = Astro.props;
const Icon = project.icon;
const others = projects.filter((p) => p.slug !== project.slug).slice(0, 3);

const display = 'font-[family-name:var(--font-nunito)] font-extrabold tracking-[-0.01em]';
const mono = 'font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.18em]';
const shell = 'mx-auto w-full max-w-[1100px] px-5 sm:px-8 lg:px-10';

const path = `/case-studies/${project.slug}`;
const title = `${project.title} — Case Study | Mehfooz-ur-Rehman`;
const description = project.summary;

const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${SITE_URL}${path}#work`,
    name: project.title,
    description: project.summary,
    url: `${SITE_URL}${path}`,
    author: { '@id': `${SITE_URL}/#person` },
    keywords: project.stack.join(', '),
    genre: project.category,
    ...(project.url ? { sameAs: project.url } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portfolio', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: project.title, item: `${SITE_URL}${path}` },
    ],
  },
];
---

<Base title={title} description={description} path={path} ogType="article" jsonLd={jsonLd}>
  <SiteNav base="/" />
  <main class="relative min-h-screen overflow-x-hidden bg-[var(--color-page)] text-[var(--color-text)]">
    <div class="halo -left-[10%] -top-[6%] h-[34rem] w-[34rem]" style="background: var(--halo-a)"></div>

    <div class={`${shell} relative z-10 pb-20 pt-28 sm:pt-32`}>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border-card)] bg-[var(--color-field)] px-4 py-2 text-[0.78rem] font-bold text-[var(--color-text)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)]"
      >
        <ArrowLeft size={14} aria-hidden="true" /> Back to portfolio
      </a>

      <section class="mt-10 grid gap-10 lg:grid-cols-[1fr_0.82fr] lg:items-start">
        <div class="max-w-2xl">
          <p class={`${mono} text-[var(--color-accent)]`}>Case study</p>
          <p class={`${mono} mt-3 text-[var(--color-soft)]`}>{project.category}</p>
          <h1 class={`${display} mt-4 text-[clamp(2.4rem,5vw,4.4rem)] leading-[0.95]`}>{project.title}</h1>
          <p class="mt-6 max-w-xl text-[1rem] leading-8 text-[var(--color-muted)]">{project.summary}</p>
          <ul class="mt-7 flex flex-wrap gap-1.5">
            {
              project.highlights.map((item) => (
                <li class="rounded-md border border-[var(--border-subtle)] bg-[var(--color-raise)] px-2.5 py-1 font-mono-label text-[0.64rem] font-semibold text-[var(--color-muted)]">{item}</li>
              ))
            }
          </ul>
        </div>

        <aside class="rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="grid size-12 place-items-center rounded-xl border border-[var(--border-card)] bg-[var(--color-page)]">
                {
                  project.logo ? (
                    <Image src={project.logo} alt="" width={64} height={64} class="size-8 object-contain" aria-hidden="true" />
                  ) : (
                    <Icon size={20} class="text-[var(--color-accent)]" aria-hidden="true" />
                  )
                }
              </span>
              <div>
                <p class={`${mono} text-[var(--color-soft)]`}>Snapshot</p>
                <p class="mt-1 text-[0.95rem] font-extrabold">{project.title}</p>
              </div>
            </div>
            {
              project.url ? (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-inverse)] px-3 py-1.5 text-[0.72rem] font-bold text-[var(--color-inverse-text)] transition hover:bg-[var(--color-accent)] hover:text-[var(--color-on-accent)]"
                >
                  Visit <ArrowUpRight size={13} aria-hidden="true" />
                </a>
              ) : null
            }
          </div>

          {
            project.hero ? (
              <div class="mt-5 overflow-hidden rounded-xl border border-[var(--border-card)]">
                <Image
                  src={project.hero}
                  alt={`${project.title} screenshot`}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 1024px) 90vw, 480px"
                  loading="eager"
                  fetchpriority="high"
                  class="h-auto w-full object-cover"
                />
              </div>
            ) : null
          }

          <dl class="mt-5 grid grid-cols-2 gap-2.5">
            {
              [
                ['Role', 'Full-stack delivery'],
                ['Focus', project.category],
                ['Stack', project.stack[0] ?? 'Web'],
                ['Mode', 'Product build'],
              ].map(([label, value]) => (
                <div class="rounded-xl border border-[var(--border-card)] bg-[var(--color-page)] p-3">
                  <dt class={`${mono} text-[var(--color-accent)]`}>{label}</dt>
                  <dd class="mt-1 text-[0.82rem] font-bold">{value}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </section>

      <section class="mt-10 grid gap-3 md:grid-cols-3">
        {
          [
            ['Problem', project.problem],
            ['Approach', project.approach],
            ['Outcome', project.outcome],
          ].map(([label, value], i) => (
            <article class="card-hover rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-6">
              <span class="font-mono-label text-[0.7rem] font-semibold text-[var(--color-soft)]">0{i + 1}</span>
              <h2 class={`${mono} mt-2 text-[var(--color-accent)]`}>{label}</h2>
              <p class="mt-3 text-[0.92rem] leading-7 text-[var(--color-muted)]">{value}</p>
            </article>
          ))
        }
      </section>

      <section class="mt-3 grid gap-3 lg:grid-cols-[1.05fr_0.95fr]">
        <article class="rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-6">
          <h2 class={`${mono} text-[var(--color-accent)]`}>Responsibilities</h2>
          <ul class="mt-4 grid gap-3 text-[0.92rem] leading-7 text-[var(--color-muted)]">
            {
              project.responsibilities.map((item) => (
                <li class="flex gap-3">
                  <CircleCheck class="mt-0.5 shrink-0 text-[var(--color-accent-2)]" size={17} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-6">
          <h2 class={`${mono} text-[var(--color-accent)]`}>Stack</h2>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {
              project.stack.map((item) => (
                <li class="rounded-md border border-[var(--border-subtle)] bg-[var(--color-page)] px-2.5 py-1 font-mono-label text-[0.64rem] font-semibold text-[var(--color-muted)]">{item}</li>
              ))
            }
          </ul>
          <div class="mt-5 rounded-xl border border-[var(--border-card)] bg-[var(--color-page)] p-4">
            <h3 class={`${mono} text-[var(--color-soft)]`}>At a glance</h3>
            <p class="mt-2 text-[0.9rem] leading-7 text-[var(--color-muted)]">{project.businessValue}</p>
          </div>
        </article>
      </section>

      <section class="mt-10" aria-labelledby="more-work">
        <h2 id="more-work" class={`${mono} text-[var(--color-soft)]`}>More case studies</h2>
        <ul class="mt-4 grid gap-3 md:grid-cols-3">
          {
            others.map((p) => (
              <li>
                <a
                  href={`/case-studies/${p.slug}`}
                  data-astro-prefetch="hover"
                  class="card-hover flex h-full flex-col justify-between gap-4 rounded-2xl border border-[var(--border-card)] bg-[var(--color-raise)] p-5"
                >
                  <span class="text-[0.95rem] font-extrabold leading-snug">{p.title}</span>
                  <span class="inline-flex items-center gap-1.5 font-mono-label text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
                    Read <ArrowRight size={13} aria-hidden="true" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-10 flex flex-col items-start justify-between gap-5 rounded-2xl border border-[var(--border-card)] bg-[var(--color-page-soft)] p-6 sm:flex-row sm:items-center">
        <div>
          <p class={`${display} text-[1.2rem]`}>Building something similar?</p>
          <p class="mt-1 text-[0.9rem] text-[var(--color-muted)]">Let's talk about your product.</p>
        </div>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 text-[0.88rem] font-bold text-[var(--color-on-accent)] shadow-lg shadow-[color:var(--shadow-accent)]"
        >
          {profile.email}
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
      </section>
    </div>
  </main>
</Base>
