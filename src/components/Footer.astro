---
import { profile } from '../data';
import Logo from './Logo.astro';

interface Props {
  /** '' on the home page, '/' elsewhere so in-page anchors point home. */
  base?: string;
}
const { base = '' } = Astro.props;

const shell = 'mx-auto w-full max-w-[1320px] px-5 sm:px-8 lg:px-10';
const versions = [1, 2, 3, 4, 5, 6, 7].map((n) => [`v${n}`, `https://mehfoozurrehmanv${n}.web.app/`]);
---

<footer class="border-t border-[var(--border-hairline)] bg-[var(--color-page)]">
  <div class={`${shell} pb-24 pt-10 sm:pb-10`}>
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <a href={base ? '/' : '#page-top'} class="flex items-center gap-3">
        <Logo class="size-9" />
        <span class="font-mono-label text-[0.72rem] font-semibold uppercase tracking-[0.2em]">Mehfooz-ur-Rehman</span>
      </a>
      <nav aria-label="Footer" class="-mx-2 flex flex-wrap font-mono-label text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)]">
        {
          [
            ['Work', `${base}#work`],
            ['Experience', `${base}#experience`],
            ['Contact', `${base}#contact`],
            ['CV', '/cv.pdf'],
            ['GitHub', profile.github],
            ['LinkedIn', profile.linkedin],
          ].map(([label, href]) => (
            <a href={href} {...(href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {})} class="px-2 py-2.5 transition hover:text-[var(--color-accent)]">{label}</a>
          ))
        }
      </nav>
    </div>
    <div class="mt-8 flex flex-col gap-3 border-t border-[var(--border-subtle)] pt-6 text-[0.72rem] text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {new Date().getFullYear()} Mehfooz-ur-Rehman. Built with Astro and React<span class="hidden sm:inline"> · </span>{' '}
        <a href="https://github.com/MehfoozurRehman/portfolio" target="_blank" rel="noreferrer" class="mt-1 inline-block py-1 text-[var(--color-text)] sm:mt-0 underline decoration-[var(--border-subtle)] underline-offset-4 transition hover:text-[var(--color-accent)]">source on GitHub</a>
      </p>
      <p class="flex flex-wrap items-center">
        <span class="mr-2 text-[var(--color-soft)]">Earlier versions</span>
        {
          versions.map(([label, href]) => (
            <a href={href} target="_blank" rel="noreferrer" class="px-2 py-2.5 font-mono-label font-semibold transition hover:text-[var(--color-accent)]" title={`Portfolio ${label}`}>{label}</a>
          ))
        }
      </p>
    </div>
  </div>
</footer>
