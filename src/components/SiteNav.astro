---
import { Moon, Sun } from '@lucide/astro';
import Logo from './Logo.astro';

interface Props {
  /** Prefix for in-page anchors; '' on the home page, '/' on other pages. */
  base?: string;
}
const { base = '' } = Astro.props;

const links = [
  { label: 'About', href: `${base}#about` },
  { label: 'Services', href: `${base}#services` },
  { label: 'Work', href: `${base}#work` },
  { label: 'Experience', href: `${base}#experience` },
];
const home = base ? '/' : '#page-top';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-3 pt-3 sm:pt-4">
  <nav
    data-nav
    data-scrolled="false"
    class="pointer-events-auto flex w-full max-w-[1320px] items-center justify-between gap-2 rounded-2xl border border-transparent bg-transparent px-3 py-2 transition-all duration-300 data-[scrolled=true]:border-[var(--border-card)] data-[scrolled=true]:bg-[var(--color-page-soft)]/80 data-[scrolled=true]:shadow-[0_10px_40px_-24px_var(--shadow-strong)] data-[scrolled=true]:backdrop-blur-xl sm:px-4"
    aria-label="Primary"
  >
    <a href={home} data-home aria-label="Mehfooz-ur-Rehman — home" class="group flex items-center gap-2.5">
      <span class="grid size-9 place-items-center"><Logo class="size-9" /></span>
      <span class="hidden font-mono-label text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-[var(--color-text)] sm:block">Mehfooz</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-spy
            class="rounded-full px-3.5 py-2 font-mono-label text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)] transition hover:text-[var(--color-text)] data-[active]:bg-[var(--color-field)] data-[active]:text-[var(--color-accent)]"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href={`${base}#contact`}
        class="hidden rounded-full bg-[var(--color-inverse)] px-4 py-2 font-mono-label text-[0.7rem] font-bold uppercase tracking-[0.14em] text-[var(--color-inverse-text)] transition hover:bg-[var(--color-accent)] hover:text-[var(--color-on-accent)] sm:inline-flex"
      >
        Contact
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        class="inline-grid size-9 place-items-center rounded-full border border-[var(--border-card)] text-[var(--color-text)] transition hover:border-[var(--border-hover)] hover:text-[var(--color-accent)] sm:size-10"
      >
        <Moon class="theme-toggle-icon-light" size={17} aria-hidden="true" />
        <Sun class="theme-toggle-icon-dark" size={17} aria-hidden="true" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="group grid size-9 place-items-center rounded-full border border-[var(--border-card)] text-[var(--color-text)] transition hover:border-[var(--border-hover)] md:hidden"
      >
        <span class="relative block h-3 w-4">
          <span class="absolute left-0 top-0 h-0.5 w-4 bg-current transition-all group-aria-expanded:top-1.5 group-aria-expanded:rotate-45"></span>
          <span class="absolute left-0 top-1.5 h-0.5 w-4 bg-current opacity-100 transition-all group-aria-expanded:opacity-0"></span>
          <span class="absolute left-0 top-3 h-0.5 w-4 bg-current transition-all group-aria-expanded:top-1.5 group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-menu
    data-open="false"
    class="pointer-events-none fixed inset-x-3 top-[68px] z-40 origin-top scale-95 rounded-2xl border border-[var(--border-card)] bg-[var(--color-page-soft)]/95 p-2 opacity-0 shadow-[0_20px_60px_-30px_var(--shadow-strong)] backdrop-blur-xl transition-all duration-200 data-[open=true]:pointer-events-auto data-[open=true]:scale-100 data-[open=true]:opacity-100 md:hidden"
  >
    {
      [...links, { label: 'Contact', href: `${base}#contact` }].map((link) => (
        <a
          href={link.href}
          class="flex items-center justify-between rounded-xl px-4 py-3 font-mono-label text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-text)] transition hover:bg-[var(--color-field)] hover:text-[var(--color-accent)]"
        >
          {link.label}
          <span class="text-[var(--color-soft)]">→</span>
        </a>
      ))
    }
  </div>
</header>
